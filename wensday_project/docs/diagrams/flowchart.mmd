flowchart LR
  UI[PyQt GUI]
  SpeechIn[Speech Input]
  SpeechOut[Speech Output]
  Assistant[Assistant Core]
  IntentDB[Intents]
  Actions[Action Handlers]
  Scheduler[Alarm Scheduler]
  Persistence[(SQLite / JSON)]
  OpenAI[Optional OpenAI API]
  Calendar[Google Calendar OAuth]
  WakeWord[Optional Porcupine Wake Word]

  UI -->|text| Assistant
  SpeechIn -->|transcribed text| Assistant
  Assistant --> IntentDB
  Assistant -->|dispatch| Actions
  Assistant -->|unmatched question| OpenAI
  Actions --> Scheduler
  Actions --> Persistence
  Actions -->|optional events| Calendar
  Assistant --> SpeechOut
  UI --> SpeechOut
  WakeWord -->|activation| UI
